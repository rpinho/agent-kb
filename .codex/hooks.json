{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.claude/hooks/guard-main-tree.sh\"",
            "timeout": 10,
            "statusMessage": "Checking main-tree guard"
          }
        ]
      }
    ]
  }
}

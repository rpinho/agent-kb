<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps scripts/kb-server.py running (RunAtLoad + KeepAlive). Replace the placeholders. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.kb-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/ABSOLUTE/PATH/TO/your-kb/scripts/kb-server.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>KB_ROOT</key><string>/ABSOLUTE/PATH/TO/your-kb</string>
    <key>KB_HOST</key><string>127.0.0.1</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/tmp/kb-server.log</string>
</dict>
</plist>
